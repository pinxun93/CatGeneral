  dialogueLines:
  - characterName: "\u65C1\u767D"
    dialogueText: "\u6751\u6C11\u6C89\u9ED8\u826F\u4E45\uFF0C\u6700\u7D42\u9078\u64C7\u66FF\u7942\u5B8C\u6210\u672A\u7ADF\u7684\u5FC3\u9858\u3002"
