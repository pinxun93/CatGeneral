    sfx: {fileID: 0}
  - characterName: "\u65C1\u767D"
    dialogueText: "\u5728\u5C71\u6797\u8173\u4E0B\uFF0C\u4ED6\u5011\u5EFA\u8D77\u4E00\u5EA7\u5C0F\u5C0F\u7684\u5EDF\u5B87\uFF0C\u4F9B\u5949\u90A3\u4F4D\u5B88\u8B77\u81EA\u5DF1\u7684\u300C\u5C07\u8ECD\u300D\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u65C1\u767D"
