  background: {fileID: 2657139620823383744, guid: e161bd02f6cdc0747b4a770ca9f9d529, type: 3}
  dialogueLines:
  - characterName: "\u65C1\u767D"
    dialogueText: "\u4E3B\u89D2\u5C07\u4E09\u4EF6\u820A\u7269\uFF08\u5E03\u5076\u3001\u756B\u50CF\u3001\u9805\u5708\uFF09\u653E\u5728\u5730\u4E0A"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u65C1\u767D"
    dialogueText: "\u6708\u5149\u7167\u4EAE\u7269\u54C1\uFF0C\u6DE1\u6DE1\u7684\u5149\u6688\u9023\u6210\u4E00\u5708\u6CD5\u9663\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u65C1\u767D"
    dialogueText: "\u8C93\u5996\u975C\u975C\u7AD9\u5728\u4E00\u65C1\uFF0C\u773C\u795E\u4E0D\u518D\u5147\u72E0\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u8C93\u5996"
    dialogueText: "\u9019\u4E9B\uFF0C\u662F\u6211\u5011\u7684\u56DE\u61B6\u3002\u82E5\u6211\u80FD\u6210\u70BA\u5B88\u8B77\u8005\uFF0C\u4E5F\u4E0D\u6789\u6B64\u751F\u3002"
    characterSprite: {fileID: -5365263398696292155, guid: 77339cacadab65c48b000b4628b5fa45, type: 3}
    sfx: {fileID: 0}
  - characterName: "\u4E3B\u89D2"
    dialogueText: "\u9858\u4F60\u5F97\u5230\u5B89\u606F\uFF0C\u9858\u9019\u6751\u838A\u91CD\u7372\u5E73\u975C\u3002"
    characterSprite: {fileID: 8785289583145846344, guid: 6483f0fbf6a794844a7b3b2496dfba50, type: 3}
    sfx: {fileID: 0}
