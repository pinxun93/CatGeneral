  m_Script: {fileID: 11500000, guid: f8c1e35e1ecbe364980d5c8a641cfa28, type: 3}
  m_Name: Chapter3-4-2-4
  m_EditorClassIdentifier: 
  dialogueTitle: Chapter2_Scene_3
  background: {fileID: 2657139620823383744, guid: e161bd02f6cdc0747b4a770ca9f9d529, type: 3}
  dialogueLines:
  - characterName: "\u6B77\u53F2\u88DC\u8FF0"
    dialogueText: "\u4EE5\u4E0A\u7684\u4E8B\u4EF6\uFF0C\u7686\u53D6\u6750\u81EA\u8C93\u5C07\u8ECD\u7684\u751F\u524D\u6B77\u53F2\uFF0C\u7D93\u6539\u7DE8\u5F8C\u5448\u73FE\u5728\u904A\u6232\u4E4B\u4E2D\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u6B77\u53F2\u88DC\u8FF0"
    dialogueText: "\u5B9C\u862D\u982D\u57CE\u7576\u5730\u78BA\u5BE6\u6D41\u50B3\u8457\u4E00\u6BB5\u8A6D\u8B4E\u50B3\u8AAA\u2014\u2014"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u6B77\u53F2\u88DC\u8FF0"
    dialogueText: "\u7260\u56DB\u8655\u8972\u64CA\u5BB6\u755C\u3001\u5E36\u4F86\u75BE\u75C5\uFF0C\u6751\u6C11\u6C42\u795E\u554F\u4F5B\u7686\u7121\u6CD5\u89E3\u6C7A\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u6B77\u53F2\u88DC\u8FF0"
    dialogueText: "\u5C31\u5728\u773E\u4EBA\u675F\u624B\u7121\u7B56\u4E4B\u6642\uFF0C\u5C71\u8C93\u900F\u904E\u4E69\u7AE5\u50B3\u8A71\uFF1A\u300C\u8981\u6211\u5B89\u5206\uFF0C\u4E0D\u518D\u4F5C\u4E82\u4E5F\u53EF\u4EE5\u2026\u2026\u4F46\u4F60\u5011\u8981\u70BA\u6211\u5EFA\u4E00\u9593\u5EDF\uFF0C\u5B9A\u671F\u796D\u62DC\u3002\u300D"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u6B77\u53F2\u88DC\u8FF0"
    dialogueText: "\u6751\u6C11\u5011\u7336\u8C6B\u518D\u4E09\uFF0C\u6700\u7D42\u7167\u8FA6\u3002\r\n\u65BC\u662F\u2014\u2014\u300C\u5C07\u8ECD\u5EDF\u300D\u8A95\u751F\u4E86\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: "\u6B77\u53F2\u88DC\u8FF0"
    dialogueText: "\u81EA\u90A3\u5929\u8D77\uFF0C\u5C71\u8C93\u5996\u602A\u4FE1\u5B88\u627F\u8AFE\uFF0C\u4E0D\u518D\u798D\u5BB3\u767E\u59D3\uFF0C\u53CD\u800C\u6210\u70BA\u6751\u838A\u7684\u5B88\u8B77\u795E\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
