  dialogueLines:
  - characterName: "\u4E3B\u89D2"
    dialogueText: "\u6211\u8B93\u4F60\u5B64\u55AE\u3001\u53D7\u82E6\u2026\u2026\u4F46\u73FE\u5728\uFF0C\u6211\u628A\u4F60\u5E36\u56DE\u4F86\u4E86\u3002"
