    sfx: {fileID: 0}
  - characterName: "\u65C1\u908A"
    dialogueText: "\u4E3B\u89D2\u5C07\u9805\u5708\u653E\u5728\u796D\u58C7\u4E2D\u592E\u539F\u672C\u7684\u7070\u5370\u8655\u3002\u5149\u7D0B\u958B\u59CB\u5FAE\u5FAE\u767C\u4EAE\u3002"
    characterSprite: {fileID: 0}
    sfx: {fileID: 0}
  - characterName: 
    dialogueText: "\u4EFB\u52D9\u66F4\u65B0\uFF1A\u5C07\u6536\u96C6\u5230\u7684\u7269\u54C1\uFF08\u5E03\u5076\u3001\u756B\u50CF\u3001\u9805\u5708\uFF09\u653E\u5728\u796D\u58C7\u4E2D\u4E26\u9032\u884C\u5100\u5F0F\u3002"
